{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    // The vendored CSS parser is plain CommonJS JavaScript in the source tree (client/css/vendor),
    // so no host install has to resolve a `file:` dependency. allowJs compiles it beside the code
    // that imports it, which keeps the relative import identical in client/ and dist/.
    "allowJs": true,
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    // "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  // Only these trees are inputs. The include list is explicit because allowJs would otherwise reach
  // every .js in the checkout - including the ignored dist-iife bundle and the engine itself through
  // the example workspace's `web-bml: file://..` self-link in node_modules.
  "include": [
    "client",
    "protocol",
    "server",
    "es2",
    "iife",
  ],
  "exclude": [
    "example",
    "dist",
    // The suite is TypeScript now, but it runs under node's type stripping against the built dist/,
    // so it is checked by tsconfig.test.json rather than emitted into dist/test.
    "test"
  ]
}
